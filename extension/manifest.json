{
  "manifest_version": 3,
  "name": "Site Ranker Capture",
  "version": "0.2",
  "description": "Capture industrial real estate site addresses from listing pages and add them to your Site Ranker cart. Supports Crexi, LoopNet, and more.",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage", "activeTab", "tabs", "scripting"],

  "host_permissions": [
    "https://www.loopnet.com/*",
    "https://www.crexi.com/*",
    "https://www.zillow.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.loopnet.com/*"],
      "js": [
        "scrapers/normalize.js",
        "scrapers/llm-formatter.js",
        "scrapers/base-adapter.js",
        "scrapers/website-registry.js",
        "content-loopnet.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.crexi.com/*"],
      "js": [
        "scrapers/normalize.js",
        "scrapers/llm-formatter.js",
        "scrapers/base-adapter.js",
        "scrapers/website-registry.js",
        "content-crexi.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.loopnet.com/*", "https://www.crexi.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-session.js"],
      "run_at": "document_idle"
    }
  ]
}
