(function(ProfilePrintUrl){function onLoad(){ProfilePrintUrl.update=function(key,value){setTimeout(function(){var params={};if(key&&value){params[key]=value;var queryString=Object.keys(params).map(function(key){return key+"="+params[key]}).join("&"),originUrl=window.ProfilePrintUrl.PrintListingServiceUrl,hrefUrl="";hrefUrl=originUrl.indexOf("?")<0?originUrl+"?"+queryString:originUrl.includes(key)?updateQueryStringParameter(originUrl,key,params[key]):originUrl+"&"+queryString;window.ProfilePrintUrl.PrintListingServiceUrl=hrefUrl}},0)}}function updateQueryStringParameter(uri,key,value){var re=new RegExp("([?&])"+key+"=.*?(&|$)","i"),separator=uri.indexOf("?")!==-1?"&":"?";return uri.match(re)?uri.replace(re,"$1"+key+"="+value+"$2"):uri+separator+key+"="+value}onLoad()})(this.ProfilePrintUrl||(ProfilePrintUrl={}))