# backend/.env.example — Template for backend secrets
# =====================================================
# Copy this file to backend/.env and fill in your actual values.
# This file IS committed to git (no real secrets here).
# The actual .env file is gitignored.

# ── OpenAI API (required for the 5 agents + synthesizer) ──────────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your_key_here

# ── Mireye Earth API (required for location intelligence) ─────────────────
# Get your key from: https://mireye.com
# The same key is also in C:\Users\nayak\Desktop\mireye\.env
MIREYE_API_KEY=your_mireye_jwt_here

# ── Mireye optional overrides (defaults are fine, leave as-is) ────────────
MIREYE_BASE_URL=https://api.mireye.com
MIREYE_TIMEOUT=30.0
